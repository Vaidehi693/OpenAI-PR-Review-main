#!/bin/bash
echo "🚀 pre-push hook started!"

BRANCH=$(git symbolic-ref --short HEAD)
echo "🌿 Branch: $BRANCH"

# ─── GITHUB TOKEN ───────────────────────────────────────────
if [ -n "$GITHUB_TOKEN" ]; then
  echo "✅ Using token from environment variable"
elif security find-generic-password -a "$USER" -s "github-token" -w &>/dev/null; then
  GITHUB_TOKEN=$(security find-generic-password -a "$USER" -s "github-token" -w)
  echo "✅ Using token from keychain"
elif command -v gh &>/dev/null; then
  GITHUB_TOKEN=$(gh auth token)
  echo "✅ Using token from GitHub CLI"
else
  echo "🔑 No GitHub token found. Enter your GitHub Token:"
  read -s GITHUB_TOKEN
  security add-generic-password -a "$USER" -s "github-token" -w "$GITHUB_TOKEN"
  echo "✅ Token saved to keychain for future use"
fi

echo "🔑 Token: ${GITHUB_TOKEN:0:4}****"

# ─── GITHUB REPO ────────────────────────────────────────────
if [ -n "$GITHUB_REPO" ]; then
  echo "✅ Using repo from environment variable"
elif security find-generic-password -a "$USER" -s "github-repo" -w &>/dev/null; then
  GITHUB_REPO=$(security find-generic-password -a "$USER" -s "github-repo" -w)
  echo "✅ Using repo from keychain"
else
  GITHUB_REPO=$(git remote get-url origin \
    | sed 's/https:\/\/github.com\///' \
    | sed 's/git@github.com://' \
    | sed 's/.git$//')
  if [ -n "$GITHUB_REPO" ]; then
    echo "✅ Auto-detected repo from git remote: $GITHUB_REPO"
    security add-generic-password -a "$USER" -s "github-repo" -w "$GITHUB_REPO"
  else
    echo "📁 No GitHub repo found. Enter your GitHub Repo (e.g. your-org/your-repo):"
    read GITHUB_REPO
    security add-generic-password -a "$USER" -s "github-repo" -w "$GITHUB_REPO"
    echo "✅ Repo saved to keychain for future use"
  fi
fi

echo "📁 Repo: $GITHUB_REPO"
echo "🔗 URL: https://api.github.com/repos/$GITHUB_REPO/pulls?head=$BRANCH"

# ─── CREATE OR FIND PR ──────────────────────────────────────
echo "📝 Creating PR automatically..."

# Check if PR already exists using gh CLI
PR_NUMBER=$(gh pr list --head "$BRANCH" --json number --jq '.[0].number' 2>/dev/null)

if [ -n "$PR_NUMBER" ]; then
  echo "✅ Found existing PR #$PR_NUMBER"
else
  # Create new PR using gh CLI
  PR_URL=$(gh pr create --head "$BRANCH" --base main --title "$BRANCH" --body "Auto-created PR for $BRANCH" 2>&1)
  
  if [ $? -eq 0 ]; then
    # Extract PR number from URL (e.g., https://github.com/user/repo/pull/123)
    PR_NUMBER=$(echo "$PR_URL" | grep -oE '[0-9]+$')
    echo "✅ PR #$PR_NUMBER created successfully!"
  else
    echo "❌ Failed to create PR: $PR_URL"
    exit 0
  fi
fi

# ─── TRIGGER BOB REVIEW ─────────────────────────────────────
echo "🤖 BOB is reviewing PR #$PR_NUMBER..."
code --command "bob.reviewPR" --args "$PR_NUMBER"

echo "✅ BOB review triggered for PR #$PR_NUMBER!"
